"""
Jeu de données de test pour MoranjEALM.

Conçu pour produire des résultats visibles et cohérents dans :
- Synthèses (3 scénarios)
- LCR
- Gap de taux
- NII / EVE Sensitivity
- Concentration

Toutes les valeurs sont en FCFA. Date de référence : 8 mai 2026.
Volumétrie : ~120 milliards FCFA d'actifs et ~120 milliards FCFA de passifs,
correspondant à une banque CEMAC de taille moyenne.

Pour charger ces données dans la base :
    python manage.py load_sample_data
ou en option du bootstrap :
    python manage.py bootstrap_alm --with-sample
"""
from datetime import datetime, timedelta

REF = datetime(2026, 5, 8)


def _d(days: int) -> datetime:
    """Retourne une date relative à la date de référence."""
    return REF + timedelta(days=days)


