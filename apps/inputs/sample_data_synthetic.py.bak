def get_sample_for(kind: str) -> list[dict]:
    """Retourne la liste de dicts d'exemple pour un type d'input."""
    return SAMPLE_DATA.get(kind, [])


def total_records() -> int:
    return sum(len(v) for v in SAMPLE_DATA.values())
