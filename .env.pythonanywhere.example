DJANGO_SETTINGS_MODULE=alm.settings.pythonanywhere
DJANGO_SECRET_KEY=change-me-with-a-long-random-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.your-bank-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.your-bank-domain.com
DJANGO_SECURE_SSL_REDIRECT=1

# Database. SQLite is the default for the online test server.
# Use mysql only for a production-like deployment with a configured MySQL DB.
DJANGO_DB_ENGINE=sqlite
MYSQL_DB=yourusername$moranjealm
MYSQL_USER=yourusername
MYSQL_PASSWORD=change-me
MYSQL_HOST=yourusername.mysql.pythonanywhere-services.com
MYSQL_PORT=3306

# If DJANGO_DB_ENGINE=sqlite, MYSQL_* is ignored.
SQLITE_PATH=/home/yourusername/MoranjEALM/backend/db.sqlite3

# Demo only. In commercial production, configure LICENSE_SERVER_URL,
# LICENSE_KEY and LICENSE_PUBLIC_KEY_PATH, then set LICENSE_BYPASS=0.
LICENSE_BYPASS=1
